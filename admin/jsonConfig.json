{
  "i18n": true,
  "type": "panel",
  "items": {
    "_loginHeader": {
      "type": "header",
      "text": "Login",
      "size": 4
    },
    "username": {
      "type": "text",
      "label": "App Email",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "password": {
      "type": "password",
      "label": "App Password",
      "repeat": false,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "brand": {
      "type": "select",
      "label": "Brand",
      "help": "Renault / Dacia for the My Renault and My Dacia app, Alpine for the My Alpine app",
      "default": "renault",
      "options": [
        {
          "label": "Renault / Dacia",
          "value": "renault"
        },
        {
          "label": "Alpine",
          "value": "alpine"
        }
      ],
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 2,
      "xl": 2
    },
    "country": {
      "type": "select",
      "label": "Country",
      "help": "Country of the account in the app",
      "noTranslation": true,
      "default": "de",
      "options": [
        {
          "label": "Österreich (at)",
          "value": "at"
        },
        {
          "label": "Belgique / België (be)",
          "value": "be"
        },
        {
          "label": "България (bg)",
          "value": "bg"
        },
        {
          "label": "Schweiz / Suisse / Svizzera (ch)",
          "value": "ch"
        },
        {
          "label": "Česko (cz)",
          "value": "cz"
        },
        {
          "label": "Deutschland (de)",
          "value": "de"
        },
        {
          "label": "Danmark (dk)",
          "value": "dk"
        },
        {
          "label": "España (es)",
          "value": "es"
        },
        {
          "label": "Suomi (fi)",
          "value": "fi"
        },
        {
          "label": "France (fr)",
          "value": "fr"
        },
        {
          "label": "United Kingdom (gb)",
          "value": "gb"
        },
        {
          "label": "Hrvatska (hr)",
          "value": "hr"
        },
        {
          "label": "Magyarország (hu)",
          "value": "hu"
        },
        {
          "label": "Ireland (ie)",
          "value": "ie"
        },
        {
          "label": "Italia (it)",
          "value": "it"
        },
        {
          "label": "Luxembourg (lu)",
          "value": "lu"
        },
        {
          "label": "México (mx)",
          "value": "mx"
        },
        {
          "label": "Nederland (nl)",
          "value": "nl"
        },
        {
          "label": "Norge (no)",
          "value": "no"
        },
        {
          "label": "Polska (pl)",
          "value": "pl"
        },
        {
          "label": "Portugal (pt)",
          "value": "pt"
        },
        {
          "label": "România (ro)",
          "value": "ro"
        },
        {
          "label": "Россия (ru)",
          "value": "ru"
        },
        {
          "label": "Sverige (se)",
          "value": "se"
        },
        {
          "label": "Slovenija (si)",
          "value": "si"
        },
        {
          "label": "Slovensko (sk)",
          "value": "sk"
        }
      ],
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 3,
      "xl": 3
    },
    "_pollingHeader": {
      "type": "header",
      "text": "Polling",
      "size": 4,
      "newLine": true
    },
    "interval": {
      "type": "number",
      "label": "Update interval in minutes",
      "min": 5,
      "max": 1440,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 2,
      "xl": 2
    },
    "disableChargeFetching": {
      "type": "checkbox",
      "label": "Disable charge fetching",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "chargeHistoryLimit": {
      "type": "number",
      "label": "Charge history entries to keep",
      "help": "Number of most recent entries kept per charge-history endpoint (0 = unlimited)",
      "min": 0,
      "max": 1000,
      "default": 100,
      "hidden": "data.disableChargeFetching === true",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 2,
      "xl": 2
    },
    "_apiHeader": {
      "type": "header",
      "text": "API Key",
      "size": 4,
      "newLine": true
    },
    "apiKeyUpdate": {
      "type": "text",
      "label": "API Key (leave empty for auto-detect)",
      "help": "If empty, the API key will be set automatically",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 8,
      "lg": 6,
      "xl": 6
    },
    "_apiKeyLink": {
      "type": "staticLink",
      "label": "Click here for current API Key",
      "href": "https://github.com/hacf-fr/renault-api/blob/main/src/renault_api/const.py",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 8,
      "lg": 6,
      "xl": 6
    }
  }
}
