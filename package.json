{
  "name": "iobroker.renault",
  "version": "0.0.25",
  "description": "Adapter for Renault, Dacia and Alpine",
  "author": {
    "name": "TA2k",
    "email": "tombox2020@gmail.com"
  },
  "contributors": [
    {
      "name": "fungus75"
    }
  ],
  "homepage": "https://github.com/TA2k/ioBroker.renault",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "renault",
    "Renault",
    "dacia",
    "Dacia"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TA2k/ioBroker.renault.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.16.1",
    "json2iob": "^2.6.25",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@types/node": "^22.20.3",
    "globals": "^17.12.0",
    "typescript": "~6.0.3"
  },
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test:unit": "mocha test/unit --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "pr:objects": "npx --yes --package @iobroker/repochecker -- node tools/checkObjectStructure.js",
    "lint": "eslint .",
    "translate": "translate-adapter",
    "release": "release-script patch --yes --noPush",
    "release-minor": "release-script minor --yes --noPush",
    "release-major": "release-script major --yes --noPush"
  },
  "bugs": {
    "url": "https://github.com/TA2k/ioBroker.renault/issues"
  },
  "readmeFilename": "README.md"
}
